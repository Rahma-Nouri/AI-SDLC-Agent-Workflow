@@ -0,0 +1,78 @@
+-- Relational Database Schema for AI-Powered Adaptive Exam Preparation System
+-- Architecture Specification Section 5.2
+
+CREATE TABLE IF NOT EXISTS users (
+    id TEXT PRIMARY KEY,
+    email TEXT UNIQUE NOT NULL,
+    password_hash TEXT,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);
+
+CREATE TABLE IF NOT EXISTS documents (
+    id TEXT PRIMARY KEY,
+    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    title TEXT NOT NULL,
+    doc_type TEXT NOT NULL CHECK(doc_type IN ('EXAM_SAMPLE', 'LECTURE_NOTE', 'SLIDE_DECK')),
+    storage_path TEXT NOT NULL,
+    parsed_text TEXT,
+    status TEXT NOT NULL CHECK(status IN ('PENDING', 'PARSED', 'FAILED')),
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+CREATE INDEX IF NOT EXISTS idx_documents_user_id ON documents(user_id);
+
+CREATE TABLE IF NOT EXISTS exam_blueprints (
+    id TEXT PRIMARY KEY,
+    source_document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+    blueprint_json TEXT NOT NULL,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+CREATE INDEX IF NOT EXISTS idx_exam_blueprints_source_doc ON exam_blueprints(source_document_id);
+
+CREATE TABLE IF NOT EXISTS generated_exams (
+    id TEXT PRIMARY KEY,
+    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    source_blueprint_id TEXT REFERENCES exam_blueprints(id) ON DELETE SET NULL,
+    title TEXT NOT NULL,
+    is_adaptive INTEGER NOT NULL DEFAULT 0 CHECK(is_adaptive IN (0, 1)),
+    status TEXT NOT NULL CHECK(status IN ('GENERATING', 'READY', 'FAILED')),
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+CREATE INDEX IF NOT EXISTS idx_generated_exams_user_id ON generated_exams(user_id);
+
+CREATE TABLE IF NOT EXISTS questions (
+    id TEXT PRIMARY KEY,
+    exam_id TEXT NOT NULL REFERENCES generated_exams(id) ON DELETE CASCADE,
+    topic_id TEXT NOT NULL,
+    question_type TEXT NOT NULL CHECK(question_type IN ('MULTIPLE_CHOICE', 'SHORT_ANSWER', 'ESSAY')),
+    difficulty TEXT NOT NULL CHECK(difficulty IN ('BASIC', 'INTERMEDIATE', 'ADVANCED')),
+    prompt TEXT NOT NULL,
+    options_json TEXT,
+    expected_answer TEXT NOT NULL,
+    grading_rubric TEXT,
+    points INTEGER NOT NULL DEFAULT 1,
+    similarity_score REAL
+);
+CREATE INDEX IF NOT EXISTS idx_questions_exam_id ON questions(exam_id);
+CREATE INDEX IF NOT EXISTS idx_questions_topic_id ON questions(topic_id);
+
+CREATE TABLE IF NOT EXISTS exam_sessions (
+    id TEXT PRIMARY KEY,
+    exam_id TEXT NOT NULL REFERENCES generated_exams(id) ON DELETE CASCADE,
+    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    started_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    submitted_at TIMESTAMP,
+    total_score REAL,
+    max_possible_score REAL
+);
+CREATE INDEX IF NOT EXISTS idx_exam_sessions_exam_id ON exam_sessions(exam_id);
+CREATE INDEX IF NOT EXISTS idx_exam_sessions_user_id ON exam_sessions(user_id);
+
+CREATE TABLE IF NOT EXISTS exam_answers (
+    id TEXT PRIMARY KEY,
+    session_id TEXT NOT NULL REFERENCES exam_sessions(id) ON DELETE CASCADE,
+    question_id TEXT NOT NULL REFERENCES questions(id) ON DELETE CASCADE,
+    student_response TEXT NOT NULL,
+    score_awarded REAL,
+    feedback_text TEXT,
+    graded_at TIMESTAMP
+);
+CREATE INDEX IF NOT EXISTS idx_exam_answers_session_id ON exam_answers(session_id);
+CREATE INDEX IF NOT EXISTS idx_exam_answers_question_id ON exam_answers(question_id);
+
+CREATE TABLE IF NOT EXISTS longitudinal_mastery (
+    id TEXT PRIMARY KEY,
+    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    topic TEXT NOT NULL,
+    total_attempts INTEGER NOT NULL DEFAULT 0,
+    successful_attempts INTEGER NOT NULL DEFAULT 0,
+    mastery_rating REAL NOT NULL DEFAULT 0.0 CHECK(mastery_rating >= 0.0 AND mastery_rating <= 1.0),
+    last_assessed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    CONSTRAINT uq_user_topic UNIQUE (user_id, topic)
+);
+CREATE INDEX IF NOT EXISTS idx_longitudinal_mastery_user_topic ON longitudinal_mastery(user_id, topic);
