+"""Database connection and initialization utilities."""
+
+from pathlib import Path
+import sqlite3
+from typing import Optional
+
+SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
+
+
+def get_connection(db_path: str = "pilot_exam.db") -> sqlite3.Connection:
+    """Create and return a SQLite connection with foreign keys enabled."""
+    conn = sqlite3.connect(db_path)
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA foreign_keys = ON;")
+    return conn
+
+
+def init_db(db_path: str = "pilot_exam.db", schema_file: Optional[Path] = None) -> sqlite3.Connection:
+    """Execute DDL schema to initialize all required database tables."""
+    path_to_schema = schema_file or SCHEMA_PATH
+    if not path_to_schema.exists():
+        raise FileNotFoundError(f"Schema file not found at {path_to_schema}")
+
+    with open(path_to_schema, "r", encoding="utf-8") as f:
+        schema_sql = f.read()
+
+    conn = get_connection(db_path)
+    with conn:
+        conn.executescript(schema_sql)
+    return conn
+
+
+def get_table_names(conn: sqlite3.Connection) -> list[str]:
+    """Return list of existing table names in the database."""
+    cursor = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';"
+    )
+    return [row[0] for row in cursor.fetchall()]
