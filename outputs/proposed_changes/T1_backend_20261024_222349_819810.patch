+++ b/tests/test_backend_schema.py
@@ -0,0 +1,93 @@
+"""Unit tests for backend database schema and OpenAPI contract specifications."""
+
+import json
+from pathlib import Path
+import sqlite3
+import unittest
+
+from pilot.app.backend.db import init_db, get_table_names
+
+
+class TestBackendSchema(unittest.TestCase):
+    """Validate SQL schema creation, relational integrity, and OpenAPI specifications."""
+
+    def setUp(self):
+        self.conn = init_db(":memory:")
+
+    def tearDown(self):
+        self.conn.close()
+
+    def test_schema_creates_all_expected_tables(self):
+        tables = set(get_table_names(self.conn))
+        expected_tables = {
+            "users",
+            "documents",
+            "exam_blueprints",
+            "generated_exams",
+            "questions",
+            "exam_sessions",
+            "exam_answers",
+            "longitudinal_mastery",
+        }
+        self.assertTrue(expected_tables.issubset(tables), f"Missing tables: {expected_tables - tables}")
+
+    def test_foreign_key_and_check_constraints(self):
+        # Insert user
+        self.conn.execute(
+            "INSERT INTO users (id, email) VALUES (?, ?);",
+            ("u-1", "student@example.edu"),
+        )
+        # Insert document
+        self.conn.execute(
+            """INSERT INTO documents (id, user_id, title, doc_type, storage_path, status)
+               VALUES (?, ?, ?, ?, ?, ?);""",
+            ("doc-1", "u-1", "Midterm.pdf", "EXAM_SAMPLE", "/storage/Midterm.pdf", "PENDING"),
+        )
+        # Check constraint violation on invalid doc_type
+        with self.assertRaises(sqlite3.IntegrityError):
+            self.conn.execute(
+                """INSERT INTO documents (id, user_id, title, doc_type, storage_path, status)
+                   VALUES (?, ?, ?, ?, ?, ?);""",
+                ("doc-2", "u-1", "Invalid.pdf", "INVALID_TYPE", "/storage/Invalid.pdf", "PENDING"),
+            )
+
+    def test_longitudinal_mastery_unique_constraint(self):
+        self.conn.execute(
+            "INSERT INTO users (id, email) VALUES (?, ?);",
+            ("u-2", "user2@example.edu"),
+        )
+        self.conn.execute(
+            """INSERT INTO longitudinal_mastery (id, user_id, topic, total_attempts, successful_attempts, mastery_rating)
+               VALUES (?, ?, ?, ?, ?, ?);""",
+            ("lm-1", "u-2", "Virtual Memory", 10, 8, 0.8),
+        )
+        # Violate unique (user_id, topic)
+        with self.assertRaises(sqlite3.IntegrityError):
+            self.conn.execute(
+                """INSERT INTO longitudinal_mastery (id, user_id, topic, total_attempts, successful_attempts, mastery_rating)
+                   VALUES (?, ?, ?, ?, ?, ?);""",
+                ("lm-2", "u-2", "Virtual Memory", 5, 2, 0.4),
+            )
+
+    def test_openapi_spec_structure(self):
+        openapi_path = Path(__file__).resolve().parent.parent / "pilot" / "app" / "backend" / "openapi.json"
+        self.assertTrue(openapi_path.exists(), f"openapi.json not found at {openapi_path}")
+
+        with open(openapi_path, "r", encoding="utf-8") as f:
+            spec = json.load(f)
+
+        self.assertEqual(spec.get("openapi"), "3.0.3")
+        paths = spec.get("paths", {})
+        required_paths = [
+            "/api/v1/documents",
+            "/api/v1/documents/{document_id}",
+            "/api/v1/documents/{document_id}/decompose",
+            "/api/v1/jobs/{job_id}",
+            "/api/v1/exams/generate",
+            "/api/v1/exams/{exam_id}",
+            "/api/v1/exams/{exam_id}/sessions",
+            "/api/v1/exams/sessions/{session_id}/answers",
+            "/api/v1/exams/sessions/{session_id}/submit",
+            "/api/v1/exams/sessions/{session_id}/report",
+            "/api/v1/study/summarize",
+            "/api/v1/diagnostics/readiness",
+        ]
+        for endpoint in required_paths:
+            self.assertIn(endpoint, paths, f"Endpoint {endpoint} missing in OpenAPI specification")
+
+
+if __name__ == "__main__":
+    unittest.main()
