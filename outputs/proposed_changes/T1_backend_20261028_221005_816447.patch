+    doc_type: str
+    status: str
+    extracted_char_count: Optional[int] = 0
+    created_at: datetime
+
+
+class JobAccepted(BaseModel):
+    job_id: str
+
+
+class JobStatusResponse(BaseModel):
+    job_id: str
+    status: str
+    progress_percentage: int = 0
+    result_id: Optional[str] = None
+    error: Optional[str] = None
+
+
+class ExamGenerationRequest(BaseModel):
+    source_blueprint_id: str
+    study_document_ids: List[str] = Field(default_factory=list)
+    adaptive_mode: bool = False
+
+
+class ExamQuestionItem(BaseModel):
+    question_id: str
+    sequence_order: int
+    question_type: str
+    prompt: str
+    options: Optional[List[str]] = None
+    points: int
+
+
+class ExamDetailResponse(BaseModel):
+    exam_id: str
+    title: str
+    total_questions: int
+    questions: List[ExamQuestionItem]
+
+
+class SessionStartResponse(BaseModel):
+    session_id: str
+    started_at: datetime
+
+
+class AnswerItem(BaseModel):
+    question_id: str
+    student_answer: str
+
+
+class SaveAnswersRequest(BaseModel):
+    answers: List[AnswerItem]
+
+
+class SaveAnswersResponse(BaseModel):
+    status: str
+    last_saved_at: datetime
+
+
+class EvaluationItem(BaseModel):
+    question_id: str
+    score: float
+    max_score: float
+    is_correct: bool
+    feedback: str
+
+
+class ExamReportResponse(BaseModel):
+    session_id: str
+    total_score: float
+    earned_score: float
+    evaluations: List[EvaluationItem]
+
+
+class StudySummaryRequest(BaseModel):
+    document_id: str
+    focus_topics: List[str] = Field(default_factory=list)
+
+
+class StudySummaryResponse(BaseModel):
+    summary: str
+    key_points: List[str]
+    formulas: List[str]
+
+
+class TopicMasteryItem(BaseModel):
+    topic: str
+    mastery_score: float
+    status: str
+
+
+class RemediationRecommendationItem(BaseModel):
+    topic: str
+    suggested_action: str
+    reference_document_id: str
+
+
+class ReadinessDiagnosticsResponse(BaseModel):
+    overall_readiness_percentage: float
+    topic_mastery: List[TopicMasteryItem]
+    recommendations: List[RemediationRecommendationItem]
